# LLM provider: openai | gemini | grok | groq
LLM_PROVIDER=groq

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# OpenAI-compatible gateway (9Router, OpenRouter, LiteLLM, …)
# LLM_PROVIDER=openai
# OPENAI_API_BASE=http://localhost:20128/v1
# OPENAI_API_KEY=<key from 9Router dashboard>
# OPENAI_MODEL=<combo name, e.g. groq/llama-3.1-8b-instant>
OPENAI_API_BASE=

# Google Gemini (recommended for learning MVP)
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=

# xAI Grok
XAI_API_KEY=your-xai-api-key
GROK_MODEL=grok-2-1212

# Groq (fast inference, free tier — good for learning MVP)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=

# Storage
# Postgres (recommended — run: docker compose up -d && alembic upgrade head)
DATABASE_URL=postgresql+psycopg://property_intel:property_intel@localhost:5433/property_intel
# SQLite fallback (legacy)
# DATABASE_URL=sqlite:///./data/app.db
CHROMA_PATH=./data/chroma
RAW_DATA_DIR=./data/raw

# Crawl (Việc 2)
FIRECRAWL_API_KEY=
FIRECRAWL_API_BASE=https://api.firecrawl.dev
CRAWL_URLS_FILE=./data/crawl/urls.txt
CRAWL_SEARCH_URLS_FILE=./data/crawl/search_urls.txt
CRAWL_RATE_LIMIT_SECONDS=2.0
CRAWL_MAX_BODY_CHARS=8000
EXTRACT_MAX_BODY_CHARS=2500
# Rate limit: 1 LLM call/listing (extract+summary merged). 8s+ safe for Groq free tier.
EXTRACT_RATE_LIMIT_SECONDS=8.0
EXTRACT_MAX_RETRIES=4
# false = template short_description, zero extra LLM field work
EXTRACT_ENABLE_LLM_SUMMARY=true
